# InterviewForge configuration. Copy to .env and adjust. Every value has a sensible default.
APP_ENV=development

# Local SQLite database and upload folder. Defaults: <project>/data/interviewforge.db and <project>/uploads.
# DATABASE_URL=sqlite:////absolute/path/to/interviewforge.db
# UPLOAD_DIR=/absolute/path/to/uploads

# Local LLM via Ollama (free). Set LLM_PROVIDER=none to always use the offline engine.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.4
LLM_MAX_RETRIES=1

MAX_RESUME_SIZE_MB=10
INTERVIEW_DEFAULT_QUESTIONS=10
VOICE_ENABLED=true

# Deterministic mode for automated tests/CI only: no Ollama, fixed questions and scoring.
TEST_MODE=false

# Comma-separated list (or a JSON array) of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional scoring weight overrides (JSON; missing keys keep defaults; values are normalised to sum to 1).
# ATS_WEIGHTS={"keyword_match":0.2,"skills_match":0.2}
# ANSWER_WEIGHTS={"technical_correctness":0.3}
# BEHAVIORAL_ANSWER_WEIGHTS={"communication":0.25}
# INTERVIEW_WEIGHTS={"technical":0.35,"behavioral":0.05}
# READINESS_WEIGHTS={"interview":0.4,"jd_match":0.3,"ats":0.2,"evidence":0.1}
